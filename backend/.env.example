# Database connection URL
DATABASE_URL=link_to_your_database

# JWT Authentication
JWT_SECRET=your_secure_secret_key_here
JWT_EXPIRATION=1h
BCRYPT_SALT_ROUNDS=10

# Mail integration for Communication > Email Inbox
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SYNC_ENABLED=false
MAIL_SYNC_INTERVAL_SECONDS=300
